<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/pantry_item_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textIngredientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rice"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/darkText"/>

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fresh"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <TextView
        android:id="@+id/textCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grains"
        android:textStyle="italic"
        android:textColor="@color/primaryGreen"
        android:layout_marginTop="2dp"/>

    <TextView
        android:id="@+id/textQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quantity: 5 KG"
        android:layout_marginTop="6dp"/>

    <TextView
        android:id="@+id/textLowStock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Low Stock"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#F57C00"
        android:visibility="gone"
        android:layout_marginTop="2dp"/>

    <TextView
        android:id="@+id/textExpiry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Expiry: 31/12/2026"
        android:layout_marginTop="2dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/buttonEdit"
            android:layout_width="72dp"
            android:layout_height="38dp"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/primaryGreen"/>

        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="72dp"
            android:layout_height="38dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="#E53935"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>